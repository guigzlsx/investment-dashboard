# Financial data provider (server-only)
FMP_API_KEY=
# Use UNKNOWN unless your provider plan explicitly guarantees a different status.
FMP_DATA_KIND=UNKNOWN

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible fallback for projects that still expose an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required because assets are shared reference data and are not writable through client RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Conversational assistant (server-only)
OPENAI_API_KEY=
OPENAI_MODEL_QUICK=gpt-5-mini
OPENAI_MODEL_DETAILED=gpt-5.1
